# Neon connection string (Dashboard -> Connection Details). Keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:3000
# Set to true to also allow any *.vercel.app preview URL
ALLOW_VERCEL_PREVIEWS=false
